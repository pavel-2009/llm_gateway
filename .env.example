HOST=0.0.0.0
PORT=8000

# Use Ollama on the host by default. Set USE_OLLAMA_CONTAINER=true to use
# the Ollama container managed by Docker Compose instead.
USE_OLLAMA_CONTAINER=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# Optional cloud provider keys. Leave empty to use Ollama fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Tracing is enabled automatically by Docker Compose; enable it for local runs
# only when an OTLP/HTTP trace receiver is available.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=llm-gateway
OTEL_TRACE_SAMPLE_RATIO=1.0

# Set a unique password before starting the Compose stack.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
